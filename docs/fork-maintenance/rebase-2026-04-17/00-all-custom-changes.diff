+// VisitOnlineMaps calls visitor function on all managed online maps.
+func (m *Manager) VisitOnlineMaps(visitor func(string, *OnlineMap) bool) {
+	m.access.RLock()
+	defer m.access.RUnlock()
+
+	for name, om := range m.onlineMap {
+		if !visitor(name, om) {
+			break
+		}
+	}
+}
